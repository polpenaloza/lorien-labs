# Cloudflare static asset headers. The Content Security Policy lives in each page's <meta>
# (astro.config.mjs `security.csp`), except frame-ancestors, which only works as a header.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# Built files carry a content hash in their name, so they never change: cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/admin/*
  X-Robots-Tag: noindex, nofollow
