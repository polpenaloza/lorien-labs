---
import Base from '../layouts/Base.astro';
import { getBusiness } from '../lib/site';

const business = await getBusiness();
---

<Base title="Contact" description={`How to reach ${business.legal_name}.`}>
  <h1>Contact</h1>
  <p>For questions about an order, a refund or our services, write or call us.</p>
  <dl>
    <dt>Company</dt>
    <dd>{business.legal_name}, {business.entity}</dd>
    <dt>Address</dt>
    <dd>{business.address}</dd>
    <dt>Email</dt>
    <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
    <dt>Phone</dt>
    <dd><a href={`tel:${business.phone}`}>{business.phone}</a></dd>
  </dl>
</Base>
