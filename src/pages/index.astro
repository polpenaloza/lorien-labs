---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, getBusiness, getPublishedPosts } from '../lib/site';

const business = await getBusiness();
const channels = await getCollection('channels');
const offers = (await getCollection('offers')).sort((a, b) => a.data.order - b.data.order);
const latestPosts = (await getPublishedPosts()).slice(0, 3);
---

<Base title="Software, digital products and videos">
  <h1>{business.legal_name}</h1>
  <p>{business.description}</p>

  <h2>What we sell</h2>
  <ul>
    {offers.map(({ data }) => <li><strong>{data.name}.</strong> {data.description}</li>)}
  </ul>
  <p><a href="/services">See all services and prices</a></p>

  <h2>Our channels</h2>
  <ul>
    {channels.map(({ data }) => <li><a href={data.youtube}>{data.name}</a>: {data.description}</li>)}
  </ul>

  <h2>Latest from the blog</h2>
  {
    latestPosts.length > 0 ? (
      <ul>
        {latestPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            <span class="meta"> · {formatDate(post.data.date)}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p>The first posts are on their way.</p>
    )
  }
</Base>
