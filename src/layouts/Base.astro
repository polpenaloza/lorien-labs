---
import { getCollection } from 'astro:content';
import { getBusiness } from '../lib/site';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const business = await getBusiness();
const channels = await getCollection('channels');
const { title, description = business.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | {business.legal_name}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&family=Silkscreen&display=swap"
    />
  </head>
  <body>
    <header class="wrap site-header">
      <a href="/" class="brand"><img class="mark" src="/logo.png" alt="" width="49" height="49" />{business.legal_name}</a>
      <nav aria-label="Main">
        <a href="/services">Services</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="wrap site-footer">
      <div>
        <p class="label">Company</p>
        <p>
          <strong>{business.legal_name}</strong><br />
          {business.address}<br />
          <a href={`mailto:${business.email}`}>{business.email}</a><br />
          <a href={`tel:${business.phone}`}>{business.phone}</a>
        </p>
      </div>
      <nav aria-label="Legal">
        <p class="label">Legal</p>
        <a href="/terms">Terms and Conditions</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/refunds">Refund, Cancellation and Delivery Policy</a>
        <a href="/contact">Contact</a>
      </nav>
      <nav aria-label="Channels">
        <p class="label">Channels</p>
        {
          channels.map(({ data }) => (
            <>
              <a href={data.youtube}>{data.name} on YouTube</a>
              {data.instagram ? <a href={data.instagram}>{data.name} on Instagram</a> : null}
              {data.tiktok ? <a href={data.tiktok}>{data.name} on TikTok</a> : null}
            </>
          ))
        }
      </nav>
      <p class="meta footer-note">Card payments are processed securely by Stripe. We never see or store your card number.</p>
    </footer>
  </body>
</html>
