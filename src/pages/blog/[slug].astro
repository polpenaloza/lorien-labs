---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPublishedPosts, pagePath } from '../../lib/site';
import { youtubeId } from '../../lib/youtube';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const channel = await getEntry(post.data.channel);
const videoId = youtubeId(post.data.video_url);
const postUrl = new URL(pagePath(Astro.url), Astro.site);
// Structured data for search engines (schema.org).
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  url: postUrl,
  mainEntityOfPage: postUrl,
  image: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`,
  publisher: { '@id': `${Astro.site}#organization` },
  video: {
    '@type': 'VideoObject',
    name: post.data.title,
    description: post.data.summary,
    uploadDate: post.data.date.toISOString(),
    thumbnailUrl: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`,
    embedUrl: `https://www.youtube-nocookie.com/embed/${videoId}`,
    contentUrl: post.data.video_url,
  },
});
---

<Base title={post.data.title} description={post.data.summary} type="article">
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd} />
  <article>
    <p class="meta">
      {formatDate(post.data.date)} · <a href={channel.data.youtube}>{channel.data.name}</a>
    </p>
    <h1>{post.data.title}</h1>
    <div class="my-6 aspect-video">
      <iframe
        class="h-full w-full border-0"
        src={`https://www.youtube-nocookie.com/embed/${videoId}`}
        title={post.data.title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
    <Content />
    <h2>Sources</h2>
    <ul>
      {post.data.sources.map((source) => (
        <li>
          {source.url ? <a href={source.url}>{source.title}</a> : source.title}
          <span class="tag">{source.type}</span>
        </li>
      ))}
    </ul>
  </article>
</Base>
