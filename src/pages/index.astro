---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, getBusiness, getPublishedPosts } from '../lib/site';

const business = await getBusiness();
const channels = await getCollection('channels');
const offers = (await getCollection('offers')).sort((a, b) => a.data.order - b.data.order);
const latestPosts = (await getPublishedPosts()).slice(0, 3);
---

<Base title="Software, digital products and videos">
  <div class="hero">
    <img class="mark" src="/logo.png" alt="Lorien Labs logo: a tree with its roots showing" width="196" height="196" />
    <div class="hero-text">
      <h1 class="display">Lorien Labs</h1>
      <p>{business.description}</p>
      <a class="button" href="/services">See services and prices</a>
    </div>
  </div>

  <section>
    <h2>What we sell</h2>
    <div class="cards">
      {
        offers.map(({ data }) => (
          <article class="card">
            <p class="label meta">{data.category}</p>
            <h3>{data.name}</h3>
            <p>{data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Our channels</h2>
    <div class="cards">
      {
        channels.map(({ data }) => (
          <article class="card">
            <h3><a href={data.youtube}>{data.name}</a></h3>
            <p>{data.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Latest from the blog</h2>
    {
      latestPosts.length > 0 ? (
        <div class="stack">
          {latestPosts.map((post) => (
            <article class="card">
              <p class="meta">{formatDate(post.data.date)}</p>
              <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
              <p>{post.data.summary}</p>
            </article>
          ))}
        </div>
      ) : (
        <p>The first posts are on their way.</p>
      )
    }
  </section>
</Base>
